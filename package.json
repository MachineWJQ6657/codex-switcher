{
  "name": "codex-account-deck",
  "version": "0.4.2",
  "private": true,
  "description": "A local, encrypted account switcher for Codex on Windows",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/smoke.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "local.codex.accountdeck",
    "productName": "Codex Account Deck",
    "directories": {
      "output": "release/0.4.2"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "executableName": "CodexAccountDeck",
      "icon": "resources/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.59.0",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
